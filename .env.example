# unione-mcp configuration. Copy to .env or set real environment variables
# (they win over .env). Every value is validated at start-up.

# stdio (local) mode: the UniOne API key every tool acts with. Never logged.
# UNIONE_API_KEY=

# Web API base the tools call: POST <base>/<method>.json.
# UNIONE_API_URL=https://api.unione.io/en/transactional/api/v1

# http — remote mode: Streamable HTTP on /mcp, each client sends its own key.
# stdio — local mode: one session over stdin/stdout (unione-mcp stdio sets it).
# MCP_TRANSPORT=http

# http mode: how clients authenticate (stdio ignores it).
#   api_key — Authorization: Bearer <API key>, relayed to the API as X-API-KEY.
#   oauth   — OAuth 2.1 plus API keys: a bearer starting with OAUTH_TOKEN_PREFIX is
#             an access token, any other an API key. Needs AUTHORIZATION_SERVER_URL.
# AUTH_MODE=api_key

# oauth mode: the issuer of the authorization server, the scopes it offers
# (comma-separated) and how its access tokens start.
# AUTHORIZATION_SERVER_URL=
# OAUTH_SCOPES=
# OAUTH_TOKEN_PREFIX=

# oauth mode: public origin of this server; the resource is <origin>/mcp.
# Unset: derived from the bound port.
# MCP_PUBLIC_URL=

# http mode: interface to listen on. Unset = every interface. Keep 127.0.0.1 on
# a laptop: the server relays any key it is given.
# LISTEN_HOST=127.0.0.1

# Listening port. Unset = the first free port from PORT_BASE upward, written to
# PORT_FILE; set = exactly that port.
# PORT=
# PORT_BASE=3000
# PORT_ATTEMPTS=50
# PORT_FILE=.mcp-server-port

# 1/true/yes keeps only the read tools.
# MCP_READ_ONLY=0
# 1/true/yes removes send_email, the only tool that sends real mail.
# MCP_DISABLE_SEND=0

# Upstream call timeout, the largest upstream response accepted, the largest
# request body a client may POST to /mcp.
# UPSTREAM_TIMEOUT=60s
# UPSTREAM_MAX_BODY_BYTES=8388608
# MCP_MAX_REQUEST_BYTES=8388608

# http mode: OpenAI apps domain-check token, served at
# /.well-known/openai-apps-challenge. Unset = 404.
# OPENAI_APPS_CHALLENGE=

# serverInfo.version; falls back to the version compiled into the binary.
# APP_VERSION=

# debug | info | warn | error; text or json (stderr).
# LOG_LEVEL=info
# LOG_FORMAT=text
